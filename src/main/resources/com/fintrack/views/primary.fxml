<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fintrack.controller.PrimaryController">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Cabeçalho -->
    <Label styleClass="titulo" text="FinTrack - Controle Financeiro" />

    <!-- Painel de Resumo de Saldo -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Saldo Atual:" />
        <Label fx:id="lblSaldo" style="-fx-font-size: 16px; -fx-text-fill: black;" text="R$ 0,00" />
    </HBox>

    <!-- Tabela de Transações -->
    <TableView fx:id="tabelaTransacoes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colDescricao" prefWidth="250.0" text="Descrição" />
            <TableColumn fx:id="colValor" prefWidth="120.0" text="Valor (R$)" />
            <TableColumn fx:id="colData" prefWidth="150.0" text="Data" />
        </columns>
    </TableView>

    <!-- Barra de Ações (Botões) -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Nova Transação" onAction="#abrirFormularioCadastro" />
        <Button text="Remover Selecionada" onAction="#removerTransacao" />
    </HBox>

</VBox>