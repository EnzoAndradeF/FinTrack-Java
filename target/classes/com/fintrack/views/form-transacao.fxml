<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fintrack.controller.FormTransacaoController">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a365d;" text="Nova Transação" />
      
      <GridPane hgap="10.0" vgap="10.0">
         <children>
            <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="cbTipo" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Descrição:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtDescricao" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Valor (R$):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtValor" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button onAction="#cancelar" text="Cancelar" />
            <Button onAction="#salvar" style="-fx-background-color: #1d6f42; -fx-text-fill: white;" text="Salvar" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>